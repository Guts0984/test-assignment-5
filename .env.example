# Copy to .env (`cp .env.example .env`) and fill in real values for anything beyond local dev.
# Secrets have NO defaults anywhere in the code: a missing value stops the process at startup.
# The values below are development placeholders only.
# Sections are added block by block as services are introduced.

# --- PostgreSQL ---
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_dev_password
POSTGRES_DB=kanban
# Hostname of PostgreSQL as seen by the app. `postgres` is the compose service name.
POSTGRES_HOST=postgres

# --- Redis ---
# Hostname of Redis as seen by the app. `redis` is the compose service name.
REDIS_HOST=redis
REDIS_PASSWORD=kanban_dev_redis_password

# --- Object storage (MinIO, S3 compatible) ---
MINIO_ROOT_USER=kanban_minio
MINIO_ROOT_PASSWORD=kanban_dev_minio_password
S3_ENDPOINT=http://minio:9000

# --- Mail (Mailpit catches every email; its UI is on http://localhost:8025) ---
# Hostname of the SMTP server as seen by the worker. `mailpit` is the compose service name.
SMTP_HOST=mailpit

# --- Web app ---
# The public address of the site (nginx). Cross-site writes from other origins are refused.
APP_ORIGIN=http://localhost:8080

# --- Internal ---
# Shared by the web server and the API: lets the web server vouch for the visitor's IP address
# on server-side calls, so rate limits count each visitor separately. No default; at least 16
# characters.
CLIENT_IP_SECRET=kanban_dev_client_ip_secret_change_me

# --- Demo data ---
# Password of every demo user created by the seed (see README for the logins).
SEED_PASSWORD=kanban-demo-password

# --- Local development ---
# Uncomment to also publish PostgreSQL on 127.0.0.1:${POSTGRES_HOST_PORT:-5432}, so tools on
# your machine (psql, a GUI client) can reach it. Leave commented for the real stack: the
# assignment allows only nginx and the Mailpit UI to be published.
# COMPOSE_PROFILES=dev
# POSTGRES_HOST_PORT=5432
