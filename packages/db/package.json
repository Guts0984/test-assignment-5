{
  "name": "@kanban/db",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:init": "tsx src/bin/init.ts",
    "build": "esbuild src/bin/init.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/init.mjs --external:pg-native --banner:js=\"import { createRequire as __cr } from \\\"node:module\\\"; const require = __cr(import.meta.url);\" --legal-comments=none"
  },
  "dependencies": {
    "@kanban/env": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "4.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kanban/shared": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/support/postgres.ts",
    "./testing/fixture": "./test/support/fixture.ts"
  }
}
