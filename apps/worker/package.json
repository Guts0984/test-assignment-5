{
  "name": "@kanban/worker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.mjs --external:msgpackr-extract --banner:js=\"import { createRequire as __cr } from \\\"node:module\\\"; const require = __cr(import.meta.url);\" --legal-comments=none"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@kanban/env": "workspace:*",
    "@kanban/shared": "workspace:*",
    "bullmq": "6.5.1",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kanban/db": "workspace:*",
    "@testcontainers/minio": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  }
}
