{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // NestJS decorators. Metadata emission is off on purpose: the app is bundled with esbuild,
    // which cannot emit it, so every injected dependency uses an explicit @Inject(token).
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false
  },
  "include": ["src", "test", "vitest.config.ts"]
}
